local targetCardSize = UDim2.fromOffset(360, 175)

tween(card, 0.50, {
    GroupTransparency = 0,
    Size = targetCardSize,
}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local progressValue = 0
local changingStatus = false

local function setProgress(value)
    value = math.clamp(value, 0, 1)
    progressValue = value
    tween(progressFill, 0.34, {
        Size = UDim2.fromScale(value, 1),
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

local function setStatus(mainText, detailText, color)
    while changingStatus do
        task.wait()
    end
    changingStatus = true

    local fadeOutA = tween(status, 0.10, {TextTransparency = 1}, Enum.EasingStyle.Quad)
    tween(detail, 0.10, {TextTransparency = 1}, Enum.EasingStyle.Quad)
    fadeOutA.Completed:Wait()

    status.Text = mainText or "Loading..."
    status.TextColor3 = color or THEME.text
    detail.Text = detailText or ""

    tween(status, 0.16, {TextTransparency = 0}, Enum.EasingStyle.Quad)
    tween(detail, 0.16, {TextTransparency = 0}, Enum.EasingStyle.Quad)

    changingStatus = false
end

local function fail(stage, message)
    setProgress(math.max(progressValue, 0.08))
    setStatus(stage or "Loader Error", tostring(message or "Unknown error"), THEME.error)
    warn("[PuckAFK Hub] " .. tostring(stage) .. ": " .. tostring(message))
end

local function fetchSource(url)
    -- Standard HttpGet path used by most supported environments.
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and type(result) == "string" and #result > 0 then
        return true, result
    end

    -- Optional request fallback.
    local requestFunction = request
        or http_request
        or (syn and syn.request)
        or (http and http.request)

    if type(requestFunction) == "function" then
        local requestOk, response = pcall(requestFunction, {
            Url = url,
            Method = "GET",
        })

        if requestOk and type(response) == "table" then
            local body = response.Body or response.body
            local code = response.StatusCode or response.Status or response.status
            if type(body) == "string" and #body > 0 and (not code or tonumber(code) == 200) then
                return true, body
            end
        end
    end

    return false, result or "HTTP request unavailable"
end

-- =========================
-- Loader sequence
-- =========================

task.spawn(function()
    task.wait(0.18)

    setStatus("Checking Game...", "Waiting for Roblox to finish loading")
    setProgress(0.08)

    if not game:IsLoaded() then
        local loaded = false
        local connection
        connection = game.Loaded:Connect(function()
            loaded = true
            if connection then
                connection:Disconnect()
            end
        end)

        local started = os.clock()
        while not loaded and not game:IsLoaded() and os.clock() - started < 30 do
            task.wait(0.05)
        end

        if connection then
            pcall(function() connection:Disconnect() end)
        end
    end

    setProgress(0.18)
    task.wait(0.12)

    local placeId = game.PlaceId
    local route = ROUTES[placeId]

    setStatus("Finding Script...", "PlaceId: " .. tostring(placeId))
    setProgress(0.30)
    task.wait(0.20)

    if not route then
        fail("Unsupported Game", "No PuckAFK script for PlaceId " .. tostring(placeId))
        return
    end

    setStatus("Game Found", route.name)
    setProgress(0.42)
    task.wait(0.22)

    setStatus("Connecting to GitHub...", route.source)
    setProgress(0.52)

    local downloadOk, source = fetchSource(route.url)
    if not downloadOk then
        fail("Download Failed", source)
        return
    end

    setStatus("Downloading Script...", string.format("%s • %.1f KB", route.name, #source / 1024))
    setProgress(0.68)
    task.wait(0.20)

    if #source < 20 then
        fail("Invalid Script", "GitHub returned an unexpectedly small file")
        return
    end

    setStatus("Checking Compiler...", "Preparing " .. route.name)
    setProgress(0.78)
    task.wait(0.15)

    local compiler = loadstring or load
    if type(compiler) ~= "function" then
        fail("Compiler Unavailable", "This environment does not provide loadstring/load")
        return
    end

    setStatus("Loading Script...", "Compiling downloaded source")
    setProgress(0.88)

    local chunk, compileError = compiler(source)
    if not chunk then
        fail("Compile Failed", compileError)
        return
    end

    setStatus("Launching...", route.name)
    setProgress(0.96)

    local runtimeFinished = false
    local runtimeOk = true
    local runtimeError

    task.spawn(function()
        runtimeOk, runtimeError = pcall(chunk)
        runtimeFinished = true
    end)

    -- Catch immediate startup errors without forcing long-running scripts to return.
    task.wait(0.20)
    if runtimeFinished and not runtimeOk then
        fail("Launch Failed", runtimeError)
        return
    end

    setProgress(1)
    setStatus("Loaded Successfully", route.name, THEME.success)

    task.wait(0.75)

    local fade = tween(card, 0.48, {
        GroupTransparency = 1,
        Size = UDim2.fromOffset(340, 160),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    fade.Completed:Wait()

    pcall(function()
        gui:Destroy()
    end)
end)
