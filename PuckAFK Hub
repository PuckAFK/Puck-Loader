local function tween(object, duration, properties, style, direction)
    local info = TweenInfo.new(
        duration,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(object, info, properties)
    t:Play()
    return t
end

local function getGuiParent(screenGui)
    if gethui then
        local ok, result = pcall(gethui)
        if ok and result then
            return result
        end
    end

    local ok = pcall(function()
        screenGui.Parent = CoreGui
    end)
    if ok and screenGui.Parent then
        return nil
    end

    local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
    return player:WaitForChild("PlayerGui")
end

local function removeOld()
    local possibleParents = {CoreGui}

    if gethui then
        local ok, result = pcall(gethui)
        if ok and result then
            table.insert(possibleParents, result)
        end
    end

    local player = Players.LocalPlayer
    if player then
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            table.insert(possibleParents, playerGui)
        end
    end

    for _, parent in ipairs(possibleParents) do
        local old = parent:FindFirstChild("PuckAFKLoader")
        if old then
            pcall(function()
                old:Destroy()
            end)
        end
    end
end

removeOld()

