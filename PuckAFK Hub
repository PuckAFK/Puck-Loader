local progressValue = 0
local changingStatus = false

local function setProgress(value)
    value = math.clamp(value, 0, 1)
    progressValue = value
    tween(progressFill, 0.34, {
        Size = UDim2.fromScale(value, 1),
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

local function setStatus(mainText, detailText, color)
    while changingStatus do
        task.wait()
    end
    changingStatus = true

    local fadeOutA = tween(status, 0.10, {TextTransparency = 1}, Enum.EasingStyle.Quad)
    tween(detail, 0.10, {TextTransparency = 1}, Enum.EasingStyle.Quad)
    fadeOutA.Completed:Wait()

    status.Text = mainText or "Loading..."
    status.TextColor3 = color or THEME.text
    detail.Text = detailText or ""

    tween(status, 0.16, {TextTransparency = 0}, Enum.EasingStyle.Quad)
    tween(detail, 0.16, {TextTransparency = 0}, Enum.EasingStyle.Quad)

    changingStatus = false
end

local function fail(stage, message)
    setProgress(math.max(progressValue, 0.08))
    setStatus(stage or "Loader Error", tostring(message or "Unknown error"), THEME.error)
    warn("[PuckAFK Hub] " .. tostring(stage) .. ": " .. tostring(message))
end

local function fetchSource(url)
    -- Standard HttpGet path used by most supported environments.
    local ok, result = pcall(function()
        return game:HttpGet(url)
    end)

    if ok and type(result) == "string" and #result > 0 then
        return true, result
    end

    -- Optional request fallback.
    local requestFunction = request
        or http_request
        or (syn and syn.request)
        or (http and http.request)

    if type(requestFunction) == "function" then
        local requestOk, response = pcall(requestFunction, {
            Url = url,
            Method = "GET",
        })

        if requestOk and type(response) == "table" then
            local body = response.Body or response.body
            local code = response.StatusCode or response.Status or response.status
            if type(body) == "string" and #body > 0 and (not code or tonumber(code) == 200) then
                return true, body
            end
        end
    end

    return false, result or "HTTP request unavailable"
end


