if not game:IsLoaded() then game.Loaded:Wait() end

-- Explicit mode is useful for the Premium purchase page and power users.
-- The normal homepage loader does not set a mode, so users get the classic chooser.
local requestedMode = string.lower(trim(ENV.PuckHubAccessMode))
if requestedMode == "free" then
    return launchFree()
elseif requestedMode == "premium" then
    local key = readSavedKey()
    if key ~= "" then
        local silentStatus = function(textValue, isError)
            if isError then warn("[PuckAFK Hub] " .. tostring(textValue)) else print("[PuckAFK Hub] " .. tostring(textValue)) end
        end
        if launchPremium(key, silentStatus) then return end
    end
end

return runAccessGate(requestedMode == "premium")