        end)

        item.MouseButton1Click:Connect(function()
            if busy then return end
            busy = true

            -- Copy the exact route selected by THIS button. Do not store the
            -- loop variable itself and do not re-detect by PlaceId afterward.
            selectedRoute = {
                name = routeOption.name,
                source = routeOption.source,
                url = routeOption.url,
            }

            selector.Text = "  " .. selectedRoute.name
            setStatus("Script Selected", selectedRoute.name)

            tween(item, 0.14, {
                BackgroundColor3 = Color3.fromRGB(45, 70, 50),
                BackgroundTransparency = 0,
            }, Enum.EasingStyle.Quad)

            tween(menu, 0.14, {
                GroupTransparency = 1,
            }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            tween(arrow, 0.14, {
                Rotation = 45,
            }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

            task.wait(0.16)
        end)
    end

    -- Expand just enough to reveal the selector.
    tween(card, 0.32, {
        Size = UDim2.fromOffset(360, 226),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    task.wait(0.10)

    tween(picker, 0.22, {
