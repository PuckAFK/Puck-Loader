--[[
    PuckAFK Hub | Canonical Universal Access Bootstrap

    The public entry point is:
      https://puckafk.site/loader.lua

    That loader always gives normal users a Free / Premium choice.
    Free stays keyless. Premium provides the PuckAFK Discord invite,
    accepts the PuckHub key, validates it server-side, and only then
    launches the paid Premium source for the current supported game.
]]

local URL = "https://puckafk.site/loader.lua"
local ok, source = pcall(function()
    return game:HttpGet(URL)
end)

if not ok or type(source) ~= "string" or #source < 50 then
    error("[PuckAFK Hub] Could not download the canonical loader from puckafk.site.", 0)
end

local compile = loadstring or load
if type(compile) ~= "function" then
    error("[PuckAFK Hub] This executor does not provide loadstring/load.", 0)
end

local chunk, compileError = compile(source)
if not chunk then
    error("[PuckAFK Hub] Loader compile failed: " .. tostring(compileError), 0)
end

return chunk()
